# Copy to .env and set the keys: LLM_API_KEY is the Z.AI key (chat); EMBEDDING_API_KEY is the AvalAI key (embeddings). Do not commit .env.
# Compose reads this file; DB_HOST must be the postgres service name.

LLM_PROVIDER=custom
# compose.yaml pins glm-5.3-flash on cognee (first answers) and glm-5.3 on
# cognee-next-tier; this value only affects non-compose runs.
LLM_MODEL=openai/glm-5.3-flash
LLM_ENDPOINT=https://api.z.ai/api/coding/paas/v4
LLM_API_KEY=your_z_ai_api_key

EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL / EMBEDDING_DIMENSIONS MUST match the model and
# dimensions the data was INGESTED with — the embedder is frozen into
# the stored pgvector tables, and a mismatch makes every search error
# ("expected 1536 dimensions, not 3072"). compose.yaml interpolates
# these with the ADR 0004 default (text-embedding-3-large / 3072); a
# stack ingested before ADR 0004 (text-embedding-3-small / 1536) must
# pin small / 1536 here until re-ingested.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_ENDPOINT=https://api.avalai.ir/v1
EMBEDDING_API_KEY=your_avalai_api_key
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RATE_LIMIT_ENABLED=true
EMBEDDING_RATE_LIMIT_REQUESTS=120
EMBEDDING_RATE_LIMIT_INTERVAL=60

DB_PROVIDER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=cognee
DB_PASSWORD=cognee
DB_NAME=cognee_db

VECTOR_DB_PROVIDER=pgvector
GRAPH_DATABASE_PROVIDER=postgres_demo
CACHE_BACKEND=postgres

ENABLE_BACKEND_ACCESS_CONTROL=false
